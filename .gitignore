backend/target/
!backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log
*.jar
*.war
*.ear

# Node / Vite / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage outputs
coverage/
test-results/

local_pgdata/
backend/local_pgdata/

