# LifeLink Backend Environment Configuration
# Copy this file to .env for local overrides (never commit real passwords or secrets)

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Aiven Managed PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://pg-3f7545bd-ananthasangari2007-2330.j.aivencloud.com:21859/defaultdb?sslmode=require
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_MY_REAL_AIVEN_PASSWORD
DB_POOL_SIZE=5

# Port assigned by hosting environment (Render, local, etc.)
PORT=8080

# Security Secrets (Must be at least 32 characters / 256 bits for HMAC-SHA256)
APP_JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Configuration (Comma-separated allowed origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-lifelink-app.vercel.app

# Secure Bootstrap Administrator (Runs only if table has no admin user)
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_ADMIN_EMAIL=admin@lifelink.network
APP_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD
