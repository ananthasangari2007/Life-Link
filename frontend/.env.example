# ==============================================================================
# LifeLink Frontend Environment Variables
# Copy this file to .env.local for local development overrides
# ==============================================================================

# Backend API Base URL (defaults to /api/v1 if not set, which uses Vite local proxy)
# In production on Vercel, set this to your deployed Render service URL:
# VITE_API_BASE_URL=https://lifelink-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
